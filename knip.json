{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["commitlint.config.js"],
      "ignore": ["e2e/**"]
    },
    "plugins/pos-payments": {
      "entry": [
        "src/index.ts",
        "src/api/**/*.ts",
        "src/admin/**/*.ts",
        "src/providers/**/index.ts",
        "src/subscribers/**/*.ts"
      ],
      "ignoreDependencies": [
        "@medusajs/admin-shared",
        "ts-node",
        "@medusajs/test-utils"
      ]
    },
    "packages/*": {}
  }
}
