# Exemplo de variáveis de ambiente da pilha dev/e2e do plugin.
# Documentação, não config: copie para o `.env` do BACKEND hospedeiro e preencha
# lá. `.env` é ignorado pelo git — segredo nunca no repo (CONSTRAINTS 8).
# Template de valores: não afirma estados; sem emoji.

# — Mercado Pago (Fase 2): lidos pelo medusa-config do host ao montar as options
#   do provider pp_pos-terminal_mercadopago (contrato de credenciais em
#   e2e/README.md "Dependências"; padrão de env-gating no "Getting Started"
#   do README) —

# Credencial do lojista: APP_USR-… (produção) ou TEST-… (sandbox). Via env do
# host, nunca literal no repo; o boot do provider falha sem ela.
MP_ACCESS_TOKEN=

# Assinatura "x-signature" dos webhooks — valor vigente no painel de webhooks
# do DevPanel (a página de credenciais pode exibir valor obsoleto; ver
# e2e/README.md "Estado da pilha L3"). O boot do provider falha sem ela.
MP_WEBHOOK_SECRET=

# Guard de sandbox (T6): "true" SOMENTE em dev/homologação — nunca silencioso
# (warn na construção do provider) e não isenta credenciais. Default: false.
MP_POINT_TEST_MODE=

# — Flags de registro do backend hospedeiro (não são lidas pelo plugin; guiam
#   o medusa-config do host) —

# Registra os providers manuais da Fase 1 (pp_pos-terminal_card|pix|cash|transfer).
POS_PAYMENTS_MANUAL=false

# Registra o provider mercadopago na pilha de dev/e2e (e2e/README.md).
POS_PAYMENTS_MP_TEST=false

# — Backend Medusa de dev: o harness L3 lê estas credenciais deste .env
#   (BACKEND_ENV_FILE=<caminho> node e2e/l3-webhook-e2e.cjs) —

MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
DATABASE_URL=
