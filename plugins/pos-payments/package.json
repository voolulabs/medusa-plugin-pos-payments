{
  "name": "@voolulabs/medusajs-plugin-pos-payments",
  "version": "0.0.1",
  "description": "Medusa v2 plugin for Brazilian terminal (maquininha) payments - shared platform + per-acquirer adapters behind one pos-terminal provider",
  "author": "Voolu Labs",
  "license": "Apache-2.0",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    ".": {
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voolulabs/medusa-plugin-pos-payments.git",
    "directory": "plugins/pos-payments"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "pos",
    "point-of-sale",
    "pix",
    "brl",
    "voolulabs"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@medusajs/framework": ">=2.15.0",
    "@medusajs/medusa": ">=2.15.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/types": "^2.19.0",
    "@medusajs/utils": "^2.19.0",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.0.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
